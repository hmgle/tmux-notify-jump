#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tmux-notify-jump-lib.sh
. "$SCRIPT_DIR/tmux-notify-jump-lib.sh"

register_mini() {
    local pane="${TMUX_PANE:-}" tmux_info="${TMUX:-}"
    is_pane_id "$pane" || return 1
    [[ "$tmux_info" =~ ^(/.*),([0-9]+),[0-9]+$ ]] || return 1
    local socket="${BASH_REMATCH[1]}" server_pid="${BASH_REMATCH[2]}"
    local data_dir="${XDG_DATA_HOME:-${HOME:+$HOME/.local/share}}"
    local cache_dir=""
    cache_dir="$(cache_root_dir)/tmux-notify-jump/opencode"
    [[ "$data_dir" == /* && "$cache_dir" == /* ]] || return 1

    local started="" record="$cache_dir/$$.json" temp=""
    started="$(LC_ALL=C TZ=UTC0 ps -p "$$" -o lstart=)" || return 1
    [ -n "$started" ] || return 1
    mkdir -p "$cache_dir" || return 1
    [[ -d "$cache_dir" && -O "$cache_dir" && ! -L "$cache_dir" ]] || return 1
    temp="$(mktemp "$cache_dir/.mini.XXXXXX")" || return 1
    if ! jq -n --arg socket "$socket" --arg serverPID "$server_pid" --arg pane "$pane" \
        --arg processStarted "$started" --arg traceDir "$data_dir/opencode/log/direct" \
        '{socket:$socket, serverPID:$serverPID, pane:$pane, processStarted:$processStarted, traceDir:$traceDir}' >"$temp" ||
        ! mv -f "$temp" "$record"; then
        rm -f "$temp"
        return 1
    fi
}

# The PID in OpenCode's trace filename is the same PID registered here.
if (umask 077; register_mini) 2>/dev/null; then
    umask 077
    export OPENCODE_DIRECT_TRACE=1
fi
exec opencode mini "$@"
