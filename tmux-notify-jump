#!/usr/bin/env bash
set -euo pipefail

# Cross-platform entrypoint:
# - Linux/X11: notify-send + xdotool
# - macOS: terminal-notifier + osascript

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tmux-notify-jump-lib.sh
. "$SCRIPT_DIR/tmux-notify-jump-lib.sh"

load_user_config

TMUX_NOTIFY_ENTRYPOINT="$SCRIPT_DIR/tmux-notify-jump"
export TMUX_NOTIFY_ENTRYPOINT

parse_tmux_integration_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --tmux-socket)
                shift
                [ "$#" -gt 0 ] || die "--tmux-socket requires an argument"
                TMUX_NOTIFY_TMUX_SOCKET="$1"
                export TMUX_NOTIFY_TMUX_SOCKET
                ;;
            *)
                die "Unknown tmux integration option: $1"
                ;;
        esac
        shift
    done
}

case "${1:-}" in
    --tmux-init)
        shift
        parse_tmux_integration_args "$@"
        if [ -z "${TMUX_NOTIFY_TMUX_KEY:-}" ] && [ -n "${TMUX_NOTIFY_KEY:-}" ]; then
            TMUX_NOTIFY_TMUX_KEY="$TMUX_NOTIFY_KEY"
            export TMUX_NOTIFY_TMUX_KEY
        fi
        tmux_notify_tmux_init
        exit 0
        ;;
    --tmux-uninit)
        shift
        parse_tmux_integration_args "$@"
        tmux_notify_tmux_uninit
        exit 0
        ;;
    --inbox-next)
        shift
        tmux_notify_inbox_next "${TMUX_NOTIFY_SENDER_TTY:-}"
        exit $?
        ;;
    --inbox-pick)
        shift
        tmux_notify_inbox_pick "$@"
        exit $?
        ;;
    --inbox-select)
        [ "$#" -ge 2 ] || die '--inbox-select requires an entry ID'
        INBOX_SELECTED_ID="$2"
        shift 2
        if [ "${1:-}" = --sender-tty ]; then
            [ "$#" -ge 2 ] || die '--sender-tty requires an argument'
            TMUX_NOTIFY_SENDER_TTY="$2"
            shift 2
        fi
        parse_tmux_integration_args "$@"
        tmux_notify_inbox_select "$INBOX_SELECTED_ID" "${TMUX_NOTIFY_SENDER_TTY:-}"
        exit $?
        ;;
    --inbox-preview)
        [ "$#" -eq 2 ] || die '--inbox-preview requires a pane ID'
        tmux_notify_inbox_preview "$2"
        exit $?
        ;;
    --inbox-clear-all)
        tmux_notify_inbox_clear_all
        exit 0
        ;;
    --inbox-list)
        tmux_notify_inbox_list
        exit 0
        ;;
    --inbox-ack-pane)
        [ "$#" -ge 2 ] || die "--inbox-ack-pane requires an argument"
        tmux_notify_inbox_ack_pane "$2"
        exit 0
        ;;
    --inbox-ack-client)
        [ "$#" -ge 2 ] || die "--inbox-ack-client requires an argument"
        tmux_notify_inbox_ack_client "$2"
        exit 0
        ;;
esac

if [ -n "${TMUX_NOTIFY_JUMP_SH:-}" ] && [ "${_TMUX_NOTIFY_JUMP_OVERRIDE_ACTIVE:-0}" != "1" ]; then
    OVERRIDE_PATH="$TMUX_NOTIFY_JUMP_SH"
    if [[ "$OVERRIDE_PATH" != */* ]]; then
        OVERRIDE_PATH="$(type -P -- "$OVERRIDE_PATH" || true)"
    fi
    # Compare file identity, including relative paths, symlinks and hardlinks.
    if [[ ! "$OVERRIDE_PATH" -ef "${BASH_SOURCE[0]}" ]]; then
        # A custom wrapper (or another installed copy) may call this entrypoint
        # again. Apply the override only once, even if config reloads it.
        export _TMUX_NOTIFY_JUMP_OVERRIDE_ACTIVE=1
        exec "$TMUX_NOTIFY_JUMP_SH" "$@"
    fi
fi
unset _TMUX_NOTIFY_JUMP_OVERRIDE_ACTIVE

case "$(uname -s 2>/dev/null || echo "")" in
    Darwin)
        exec "$SCRIPT_DIR/tmux-notify-jump-macos.sh" "$@"
        ;;
    *)
        exec "$SCRIPT_DIR/tmux-notify-jump-linux.sh" "$@"
        ;;
esac
